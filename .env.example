# Ollama Cloud: requer uma chave criada em https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=sua_chave_ollama
OLLAMA_TIMEOUT=45

# Para usar um Ollama local, substitua as configurações acima por:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=nome-do-modelo-instalado
# OLLAMA_API_KEY=
# OLLAMA_TIMEOUT=45
